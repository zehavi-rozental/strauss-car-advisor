// STRAUSS DRIVE edge Worker (Cloudflare Workers Free): static assets + an /api proxy to the Render service.
// Build the React app first (cd ../frontend && npm run build), then: npx wrangler@4 deploy --var BACKEND_ORIGIN:<url>
// The shared secret is never in this file: npx wrangler@4 secret put EDGE_PROXY_SECRET (local: .dev.vars).
{
  "name": "strauss-drive",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    // /employee, /rep and any shared deep link get index.html (the client-side router decides)
    "not_found_handling": "single-page-application",
    // only the API runs the Worker; static asset requests are free and never count against the daily limit
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "BACKEND_ORIGIN": ""
  }
}
