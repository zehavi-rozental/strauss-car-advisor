DATABASE_URL=sqlite:///./car_advisor.db
CONFIG_MODE=dev
# LLM providers, tried in order (provider:model, comma-separated). On HTTP 429/418/5xx or a timeout
# the next entry answers. An entry that returned 429 is skipped for LLM_COOLDOWN_429_S seconds,
# one that returned 5xx or timed out for LLM_COOLDOWN_FAIL_S seconds,
# one that returned 418 until restart. Check each provider's current model list before using these.
# A lite model right after the primary: usually faster and less loaded. Reorder freely.
LLM_CHAIN=gemini:gemini-3.8-flash,gemini:gemini-3.5-flash-lite,gemini:gemini-3.7-flash,groq:openai/gpt-oss-120b,gemini:gemini-3.6-flash
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# llm_first (default): every message goes to the LLM first; the parser is the fallback and the cross-check.
# parser_first: the parser answers what it reads in full and the LLM only the rest (saves quota).
LLM_MODE=llm_first
LLM_COOLDOWN_429_S=60
LLM_COOLDOWN_FAIL_S=60
# Per call: a slower entry gives way to the next one
LLM_TIMEOUT_S=6
# Per turn: once providers have used this long, stop trying entries and answer from templates
LLM_TURN_DEADLINE_S=12
# Intro sentence before results: if the LLM is slower than this, the results show without it
LLM_INTRO_BUDGET_S=2.5
# Gemini 3: lowest accepted thinking level ("minimal" is rejected by 3.7); Gemini 2.x: thinking budget
GEMINI_THINKING_LEVEL=low
GEMINI_THINKING_BUDGET=0
# Older single provider + fallback, used only when LLM_CHAIN is empty
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
# Base URL for OpenAI-compatible providers (groq / openrouter / ollama); empty = provider default
LLM_BASE_URL=
LLM_FALLBACK_BASE_URL=
# Payslip upload (extraction only; the file is never stored). Off by default. To turn on the in-chat
# uploader: set PAYSLIP_ENABLED=true, provide GEMINI_API_KEY, and set payslip_upload_enabled: true in
# config/extensions.yaml. PAYSLIP_MODEL defaults to the first gemini model in LLM_CHAIN.
PAYSLIP_ENABLED=false
PAYSLIP_MAX_BYTES=8388608
PAYSLIP_MAX_PAGES=4
PAYSLIP_MODEL=
PAYSLIP_TIMEOUT_S=30
PAYSLIP_RATE_LIMIT_PER_MINUTE=6
PAYSLIP_DAILY_LIMIT=200
# A PDF leaves as its pay lines. A photo or a scan would leave whole: only for a demo with synthetic files.
PAYSLIP_ALLOW_FULL_FILE=false
# Privacy (docs/PRIVACY-DATA-MAP.md): the model only after the employee accepted the notice; a conversation is deleted after
# this many days with no activity (0: not purged), and locks in the browser after this many idle minutes (0: no lock).
REQUIRE_AI_CONSENT=true
# Who processes the data (app/shared/ai_policy.py; the screens never name a provider of their own). The name shown, and where
# it runs: external (a service outside the organization) or organization (the organization's own model, e.g. an
# OpenAI-compatible endpoint in LLM_BASE_URL). Gemini, Groq and OpenRouter are always external, whatever is set here.
AI_PROVIDER_NAME=
AI_PROVIDER_HOSTING=external
PAYSLIP_PROVIDER_NAME=
PAYSLIP_PROVIDER_HOSTING=
# The organization approved this deployment and its providers for real employee data, payslips included. false: a test
# environment, and the screens say that only sample payslips are uploaded. Never true without that approval.
REAL_DATA_APPROVED=false
CONVERSATION_RETENTION_DAYS=30
SESSION_IDLE_MINUTES=120
LLM_DAILY_CALL_LIMIT=3000
MESSAGE_ADDRESS_LIMIT_PER_MINUTE=120
AUTH_FAILURE_LIMIT_PER_MINUTE=60
# Verification mail: per client address per hour; addresses per conversation; links per recipient per day; all mail per day.
EMAIL_VERIFY_ADDRESS_LIMIT_PER_HOUR=12
EMAIL_ADDRESSES_PER_CONVERSATION=3
EMAIL_RECIPIENT_DAILY_LIMIT=5
EMAIL_DAILY_SEND_LIMIT=400
MAX_MESSAGE_CHARS=1000
RATE_LIMIT_PER_MINUTE=30
CREATE_RATE_LIMIT_PER_MINUTE=20
MAX_MESSAGES_PER_CONVERSATION=80
# Transport representative API: header X-Rep-Token must equal this. Empty (the default) keeps the rep API closed.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
REP_ACCESS_TOKEN=
# reads (screens' polling) per address; answers per rep session, with a ceiling per address; wrong codes per address
REP_READ_LIMIT_PER_MINUTE=45
REP_WRITE_LIMIT_PER_MINUTE=15
REP_WRITE_ADDRESS_LIMIT_PER_MINUTE=60
REP_AUTH_FAILURE_LIMIT_PER_MINUTE=10
SESSION_COOKIE_SECURE=false
LOG_LEVEL=INFO

# Mail to the employee: disabled (the default), fake (writes files to EMAIL_FAKE_DIR, sends nothing), or smtp.
# The provider is changed here, with no change of code. No real value belongs in this file.
EMAIL_BACKEND=disabled
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_ENCRYPTION_KEY=
EMAIL_PUBLIC_APP_URL=
# EMAIL_FAKE_DIR=
# A dedicated Gmail address, with an app password:
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=address@example.com
# EMAIL_SMTP_PASSWORD=
# EMAIL_FROM=STRAUSS DRIVE <address@example.com>
# Resend, from a verified domain:
# EMAIL_SMTP_HOST=smtp.resend.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=resend
# EMAIL_SMTP_PASSWORD=
# EMAIL_FROM=STRAUSS DRIVE <address@your-verified-domain.example>
