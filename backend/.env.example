DATABASE_URL=sqlite:///./car_advisor.db
CONFIG_MODE=dev
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
# Base URL for OpenAI-compatible providers (groq / openrouter / ollama); empty = provider default
LLM_BASE_URL=
LLM_FALLBACK_BASE_URL=
LLM_TIMEOUT_S=20
MAX_MESSAGE_CHARS=1000
RATE_LIMIT_PER_MINUTE=30
CREATE_RATE_LIMIT_PER_MINUTE=20
MAX_MESSAGES_PER_CONVERSATION=80
REP_ACCESS_TOKEN=change-me
SESSION_COOKIE_SECURE=false
LOG_LEVEL=INFO
